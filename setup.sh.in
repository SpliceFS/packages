#!/bin/sh
# Everything below is a function and the last line calls main, so a download that is cut
# short runs nothing at all.
#
# Usage: sh setup.sh [--remove]
#
# Sets up the SpliceFS package repository for this system: the signing key and the package
# sources. It installs no package and refreshes no package index. When it is done it prints the
# system's own commands to run next. Safe to run again: a file is rewritten only when its
# content differs.
#
# With --remove it takes away what the setup added: the package sources and the signing key, and
# nothing else. It removes no package; when it is done it prints the system's own commands for
# that. A file is removed only when its content is exactly what the setup writes. Safe to run
# again.
#
# Before it changes anything it downloads the published setup.sh and compares it with its own
# file. A copy that is incomplete, was changed or is not the latest stops there. For that it must
# be run from a file, not piped into a shell.
set -eu

# Root may inherit the caller's PATH and umask through sudo or su, and either could make this
# script run the wrong tools or write files that other users cannot read.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

# The setup_ functions are called only as "setup_$FAMILY", which ShellCheck cannot follow, so
# it reports them as unreachable or unused. Only those two codes are silenced, and no other
# check is turned off for the file.
# shellcheck disable=SC2317,SC2329
BASE_URL='@BASE_URL@'
# The install instructions, on the website, for systems the script does not set up.
INSTALL_URL='https://splicefs.org/install/'

# Where each family keeps the repository definition and the signing key. The setup writes these
# files and --remove removes them, so each path is written down once. The one that ends in _TMP
# is outside the keys folder, because apk reads every file in that folder as a key.
APT_KEY=/etc/apt/keyrings/splicefs.asc
APT_REPO=/etc/apt/sources.list.d/splicefs.sources
RPM_KEY=/etc/pki/rpm-gpg/RPM-GPG-KEY-splicefs
DNF_REPO=/etc/yum.repos.d/splicefs.repo
ZYPPER_REPO=/etc/zypp/repos.d/splicefs.repo
APK_KEY=/etc/apk/keys/splicefs.rsa.pub
APK_KEY_TMP=/etc/apk/splicefs.rsa.pub.new
APK_REPO=/etc/apk/repositories.d/splicefs.list
PKG_DIR=/usr/local/etc/pkg
PKG_KEY=$PKG_DIR/keys/splicefs.rsa.pub
PKG_REPO=$PKG_DIR/repos/splicefs.conf

usage() {
  echo "usage: sh setup.sh [--remove]" >&2
  echo "Without an argument the script sets up the package repository and the signing key. With --remove it removes them again. It never installs or removes a package; that is done with the system's own package manager." >&2
}

die() {
  echo "error: $*" >&2
  exit 1
}

warn() {
  echo "warning: $*" >&2
}

# Prints yes when the two files have the same bytes, and no when they do not. It prints instead
# of returning a status, so a caller in a condition does not turn off set -e for this function.
# Compared in the shell when cmp is missing: cmp and diff are absent on some minimal systems.
same_file() {
  if command -v cmp >/dev/null 2>&1; then
    if cmp -s "$1" "$2"; then echo yes; else echo no; fi
  else
    sf_first=$(cat "$1")
    sf_second=$(cat "$2")
    if [ "$sf_first" = "$sf_second" ]; then echo yes; else echo no; fi
  fi
}

# The content is what the function named by the third argument prints, so --remove can ask for
# the same text. The function is called here and not at the end of a pipe, because a pipe would
# run this function in a subshell, and the cleanup trap would not know the temporary file.
# The new content goes to a temporary file first, so an interrupted run never leaves a
# half-written PATH, and an unchanged file keeps its timestamp. The temporary file must be on
# the same filesystem as PATH for the final mv to be atomic.
write_file() {
  wf_path=$1
  wf_mode=$2
  wf_content=$3
  WF_TMP=${4:-$wf_path.new}
  if [ -d "$wf_path" ]; then
    die "$wf_path is a folder; move it away and run this script again"
  fi
  "$wf_content" > "$WF_TMP"
  wf_same=no
  if [ -f "$wf_path" ]; then
    wf_same=$(same_file "$WF_TMP" "$wf_path")
  fi
  if [ "$wf_same" = yes ]; then
    rm -f "$WF_TMP"
    WF_TMP=
    chmod "$wf_mode" "$wf_path"
    return 0
  fi
  chmod "$wf_mode" "$WF_TMP"
  mv "$WF_TMP" "$wf_path"
  WF_TMP=
  echo "updated $wf_path"
}

# Removes PATH, but only when its content is what write_file would write there; the second
# argument is the function that prints it. That is the rule for a file being ours: the setup
# rewrites a changed file without asking, but a removal cannot be undone, and a file with other
# content may be the person's own or another tool's. It is left in place, with a warning. A file
# that is not there needs nothing, so a second run is quiet. The third argument is as for
# write_file.
remove_file() {
  rf_path=$1
  rf_content=$2
  if [ ! -e "$rf_path" ] && [ ! -L "$rf_path" ]; then
    return 0
  fi
  WF_TMP=${3:-$rf_path.new}
  "$rf_content" > "$WF_TMP"
  rf_same=no
  if [ -f "$rf_path" ]; then
    rf_same=$(same_file "$WF_TMP" "$rf_path")
  fi
  if [ "$rf_same" = yes ]; then
    rm -f "$rf_path"
    echo "removed $rf_path"
  else
    warn "$rf_path is not what the setup script writes, so it was left in place;" \
      "remove it yourself if you do not need it"
  fi
  rm -f "$WF_TMP"
  WF_TMP=
}

# Removes the folder when nothing is in it. The setup makes the folders it writes into when they
# are not there, and a removal that left them would leave a folder only SpliceFS ever needed. A
# folder with anything in it, a file of another maker or the system's own, stays, and so does a
# folder that is not there.
remove_empty_folder() {
  ref_dir=$1
  if [ ! -d "$ref_dir" ] || [ -L "$ref_dir" ]; then
    return 0
  fi
  ref_content=$(ls -A "$ref_dir")
  if [ -z "$ref_content" ]; then
    rmdir "$ref_dir"
    echo "removed the empty folder $ref_dir"
  fi
}

# The path is only known at run time, so ShellCheck cannot follow the sourced file.
# shellcheck disable=SC1090
# The family decides which package manager and which repository format to use.
detect_family() {
  # FreeBSD is asked for by name first, so the Linux logic below, which reads the os-release
  # file, is never reached on FreeBSD and stays as it was.
  df_os=$(uname -s)
  if [ "$df_os" = FreeBSD ]; then
    FAMILY=pkg
    return 0
  fi
  if [ -r /etc/os-release ]; then
    OS_RELEASE=/etc/os-release
  elif [ -r /usr/lib/os-release ]; then
    OS_RELEASE=/usr/lib/os-release
  else
    die "unsupported system 'unknown'; see $INSTALL_URL for the manual steps"
  fi
  # ID and ID_LIKE are read in subshells so nothing in the file can change this script's
  # variables or abort it.
  ID=$( . "$OS_RELEASE" >/dev/null 2>&1; printf %s "${ID:-}" )
  ID_LIKE=$( . "$OS_RELEASE" >/dev/null 2>&1; printf %s "${ID_LIKE:-}" )
  case "$ID" in
    debian | ubuntu) FAMILY=apt ;;
    rhel | rocky | almalinux | centos | fedora | amzn | ol) FAMILY=dnf ;;
    opensuse* | sles | sled) FAMILY=zypper ;;
    alpine) FAMILY=apk ;;
    *)
      case " $ID_LIKE " in
        *" debian "*) FAMILY=apt ;;
        *" rhel "* | *" fedora "*) FAMILY=dnf ;;
        *suse*) FAMILY=zypper ;;
        *) die "unsupported system '${ID:-unknown}'; see $INSTALL_URL for the manual steps" ;;
      esac
      ;;
  esac
}

# Checked before anything is written, so a missing tool never leaves a half-configured system.
check_tools() {
  case "$FAMILY" in
    apt)
      command -v apt-get >/dev/null 2>&1 || die "apt-get not found"
      ;;
    dnf)
      # yum takes the same repository file and the same install arguments.
      if command -v dnf >/dev/null 2>&1; then
        RPM_TOOL=dnf
      elif command -v yum >/dev/null 2>&1; then
        RPM_TOOL=yum
      else
        die "no supported package manager found (dnf or yum)"
      fi
      ;;
    zypper)
      command -v zypper >/dev/null 2>&1 || die "zypper not found"
      ;;
    apk)
      command -v apk >/dev/null 2>&1 || die "apk not found"
      ;;
    pkg)
      # /usr/sbin/pkg is in the FreeBSD base system, so a missing pkg means a damaged system.
      command -v pkg >/dev/null 2>&1 || die "pkg not found"
      ;;
    *)
      # detect_family sets FAMILY to one of the five values above, so nothing is left to check.
      ;;
  esac
}

# What only the setup needs, so a removal still works on a system that has lost the
# certificates or gained transactional-update since.
check_setup_system() {
  case "$FAMILY" in
    apt)
      # The repository is https. This script installs no package, so the missing bundle is
      # reported here, before anything is written, instead of as a failed apt-get update later.
      if [ ! -f /etc/ssl/certs/ca-certificates.crt ]; then
        die "/etc/ssl/certs/ca-certificates.crt is missing, and apt needs it for https sources;" \
          "install the ca-certificates package, then run this script again"
      fi
      ;;
    zypper)
      if command -v transactional-update >/dev/null 2>&1; then
        die "this system installs packages with transactional-update;" \
          "the manual steps at $BASE_URL/ apply"
      fi
      ;;
    *)
      # The other families have nothing more to check.
      ;;
  esac
}

# Packages are static binaries, but the repositories are split per CPU type. FreeBSD names the
# same two CPU types amd64 and arm64 in uname -m, and Linux names them x86_64 and aarch64.
check_cpu() {
  cc_cpu=$(uname -m)
  case "$FAMILY:$cc_cpu" in
    pkg:amd64 | pkg:arm64) ;;
    pkg:*) die "unsupported CPU type '$cc_cpu'; SpliceFS is built for amd64 and arm64" ;;
    *:x86_64 | *:aarch64) ;;
    *) die "unsupported CPU type '$cc_cpu'; SpliceFS is built for x86_64 and aarch64" ;;
  esac
}

# The keys travel inside this script, so installing needs no second download. Each text is
# printed by a function, so the setup can write it and --remove can compare with it.
openpgp_key() {
  cat <<'KEY_EOF'
@OPENPGP_KEY@
KEY_EOF
}

# The same RSA key is checked by Alpine's apk and by FreeBSD's pkg.
rsa_key() {
  cat <<'KEY_EOF'
@ALPINE_KEY@
KEY_EOF
}

apt_sources() {
  cat <<EOF
Types: deb
URIs: $BASE_URL/server/apt $BASE_URL/client/apt
Suites: stable
Components: main
Signed-By: $APT_KEY
EOF
}

# The backslash keeps $basearch literal, because dnf and zypper expand it themselves. The
# argument is the lines that differ between the two.
rpm_repo() {
  cat <<EOF
[splicefs-server]
name=SpliceFS server
baseurl=$BASE_URL/server/rpm/\$basearch
enabled=1
$1
gpgkey=file://$RPM_KEY

[splicefs-client]
name=SpliceFS client
baseurl=$BASE_URL/client/rpm/\$basearch
enabled=1
$1
gpgkey=file://$RPM_KEY
EOF
}

dnf_repo() {
  rpm_repo 'gpgcheck=1
repo_gpgcheck=1'
}

zypper_repo() {
  rpm_repo 'autorefresh=1
gpgcheck=1
repo_gpgcheck=1
pkg_gpgcheck=1'
}

apk_list() {
  cat <<EOF
$BASE_URL/server/alpine
$BASE_URL/client/alpine
EOF
}

# The backslash keeps the ABI variable literal in the file, because pkg replaces it itself with
# the ABI of the system it runs on. The key's path is named in the repository file, so the
# keys folder holds nothing but the key.
pkg_conf() {
  cat <<EOF
splicefs-server: {
  url: "$BASE_URL/server/freebsd/\${ABI}",
  mirror_type: "none",
  signature_type: "pubkey",
  pubkey: "$PKG_KEY",
  enabled: yes
}
splicefs-client: {
  url: "$BASE_URL/client/freebsd/\${ABI}",
  mirror_type: "none",
  signature_type: "pubkey",
  pubkey: "$PKG_KEY",
  enabled: yes
}
EOF
}

# The armor of a key without its header lines, its checksum line and its line breaks: what is
# left is the key itself, which is the same wherever the armor was written.
key_body() {
  grep -v -e '^-----' -e '^Version:' -e '^=' -e '^$' | tr -d ' \n'
}

# rpm keeps the key that rpm --import read as a package called gpg-pubkey, and the description
# of that package is the key again. The key is found by that text, so the keys of other makers
# stay. This is the only package that this script ever removes.
remove_rpm_key() {
  rk_want=$(openpgp_key | key_body)
  rpm -qa gpg-pubkey --qf '%{NAME}-%{VERSION}-%{RELEASE}\n' | while read -r rk_pkg; do
    rk_have=$(rpm -q --qf '%{DESCRIPTION}' "$rk_pkg" | key_body)
    if [ "$rk_have" = "$rk_want" ]; then
      rpm -e "$rk_pkg"
      echo "removed $rk_pkg from the rpm database"
    fi
  done
}

# Each remove_ function takes away what the setup_ function of its family wrote, the
# repository first, because it names the key. The folders come last, and only the ones that a
# system of the family does not ship: apt ships /etc/apt/keyrings and sources.list.d, the rpm
# systems ship the folder of the repository files, and Alpine ships the folder of its keys. A
# system's own folder is never removed, also when it is empty.
setup_apt() {
  install -m 0755 -d "${APT_KEY%/*}"
  write_file "$APT_KEY" 0644 openpgp_key
  write_file "$APT_REPO" 0644 apt_sources
}

remove_apt() {
  remove_file "$APT_REPO" apt_sources
  remove_file "$APT_KEY" openpgp_key
}

setup_dnf() {
  install -m 0755 -d "${RPM_KEY%/*}"
  write_file "$RPM_KEY" 0644 openpgp_key
  # The key is known to rpm from the moment the repository is added, not from the first
  # install. Importing a key that is already known is harmless.
  rpm --import "$RPM_KEY"
  write_file "$DNF_REPO" 0644 dnf_repo
}

remove_dnf() {
  remove_file "$DNF_REPO" dnf_repo
  remove_rpm_key
  remove_file "$RPM_KEY" openpgp_key
  remove_empty_folder "${RPM_KEY%/*}"
}

setup_zypper() {
  install -m 0755 -d "${RPM_KEY%/*}"
  write_file "$RPM_KEY" 0644 openpgp_key
  # Importing a key that is already known is harmless, so no check is needed first.
  rpm --import "$RPM_KEY"
  write_file "$ZYPPER_REPO" 0644 zypper_repo
}

remove_zypper() {
  remove_file "$ZYPPER_REPO" zypper_repo
  remove_rpm_key
  remove_file "$RPM_KEY" openpgp_key
  remove_empty_folder "${RPM_KEY%/*}"
}

setup_apk() {
  # The temporary file stays out of the keys folder, because apk reads every file in it.
  mkdir -p "${APK_KEY%/*}"
  write_file "$APK_KEY" 0644 rsa_key "$APK_KEY_TMP"
  mkdir -p "${APK_REPO%/*}"
  write_file "$APK_REPO" 0644 apk_list
}

remove_apk() {
  remove_file "$APK_REPO" apk_list
  remove_file "$APK_KEY" rsa_key "$APK_KEY_TMP"
  remove_empty_folder "${APK_REPO%/*}"
}

setup_pkg() {
  mkdir -p "${PKG_KEY%/*}"
  write_file "$PKG_KEY" 0644 rsa_key
  mkdir -p "${PKG_REPO%/*}"
  write_file "$PKG_REPO" 0644 pkg_conf
}

remove_pkg() {
  remove_file "$PKG_REPO" pkg_conf
  remove_file "$PKG_KEY" rsa_key
  remove_empty_folder "${PKG_KEY%/*}"
  remove_empty_folder "${PKG_REPO%/*}"
  remove_empty_folder "$PKG_DIR"
}

# The commands are the system's own, so the person can run them again later, for example to
# add the other package. Alpine and FreeBSD have no sudo by default, and their manual steps are
# written for root, so apk and pkg are printed without it. The words are left in PM, PM_UPDATE,
# PM_ADD and PM_REMOVE.
package_commands() {
  case "$FAMILY" in
    apt)
      PM='sudo apt-get'
      PM_UPDATE=update
      PM_ADD=install
      PM_REMOVE=remove
      ;;
    dnf)
      PM="sudo $RPM_TOOL"
      PM_UPDATE=makecache
      PM_ADD=install
      PM_REMOVE=remove
      ;;
    zypper)
      PM='sudo zypper'
      PM_UPDATE=refresh
      PM_ADD=install
      PM_REMOVE=remove
      ;;
    apk)
      PM=apk
      PM_UPDATE=update
      PM_ADD=add
      PM_REMOVE=del
      ;;
    pkg)
      PM=pkg
      PM_UPDATE=update
      PM_ADD=install
      PM_REMOVE=delete
      ;;
    *)
      # detect_family sets FAMILY to one of the five values above, so every value is handled.
      ;;
  esac
}

next_steps() {
  package_commands
  echo "The SpliceFS package repository is set up. Next:"
  echo
  echo "  $PM $PM_UPDATE"
  echo "  $PM $PM_ADD splicefs-server    # the server"
  echo "  $PM $PM_ADD splicefs-client    # the client"
}

# The packages stay installed, and the package manager can remove them without the repository,
# so these commands are right before and after --remove.
remove_steps() {
  package_commands
  echo "The packages are not removed by this script. To remove them:"
  echo
  echo "  $PM $PM_REMOVE splicefs-server    # the server"
  echo "  $PM $PM_REMOVE splicefs-client    # the client"
}

# The command lines that download the script and run it, indented for printing. The argument
# is the download tool that was found. apt-helper cannot print to the terminal in one line, and
# the install page leads with curl, so apt-helper, a missing tool and anything else get the
# curl line. "any" is for a script that has no file to check and so has not looked for a tool:
# it gets every line that applies to this system.
latest_lines() {
  ll_curl="  curl --proto '=https' --tlsv1.2 -fsSL $BASE_URL/setup.sh -o ~/splicefs-setup.sh && sudo sh ~/splicefs-setup.sh"
  ll_wget="  wget -qO ~/splicefs-setup.sh $BASE_URL/setup.sh && sudo sh ~/splicefs-setup.sh"
  ll_fetch="  fetch -o ~/splicefs-setup.sh $BASE_URL/setup.sh && sh ~/splicefs-setup.sh"
  case "$1" in
    wget) echo "$ll_wget" ;;
    fetch) echo "$ll_fetch" ;;
    any)
      ll_os=$(uname -s)
      if [ "$ll_os" = FreeBSD ]; then
        echo "$ll_fetch"
      else
        echo "$ll_curl"
        echo "$ll_wget"
      fi
      ;;
    *) echo "$ll_curl" ;;
  esac
}

# A copy that does not match is answered with the way to get the latest script. The first
# argument is the download tool that was found, the others are the message.
die_latest() {
  dl_tool=$1
  shift
  dl_lines=$(latest_lines "$dl_tool")
  die "$*

Get the latest setup script and run it:
$dl_lines"
}

# apt-helper is in every Debian and Ubuntu, also where curl and wget are not installed.
find_download_tool() {
  if command -v curl >/dev/null 2>&1; then
    echo curl
  elif command -v wget >/dev/null 2>&1; then
    echo wget
  elif command -v fetch >/dev/null 2>&1; then
    echo fetch
  elif [ -x /usr/lib/apt/apt-helper ]; then
    echo apt-helper
  fi
}

# Downloads the published setup script to the file CS_TMP, which check_self made and cleanup
# removes. The argument is the download tool that was found. A failed download leaves the file
# empty, and a partial one leaves a cut copy that does not match, so the caller judges what it
# got and not the exit status. The timeout keeps a dead network from hanging the script.
# apt-helper is told to download as root, because its default user cannot write to a file made
# by root and then prints a warning.
download_published() {
  dp_tool=$1
  dp_url=$BASE_URL/setup.sh
  case "$dp_tool" in
    curl) curl -fsS --max-time 30 -o "$CS_TMP" "$dp_url" || true ;;
    wget) wget -q -T 30 -O "$CS_TMP" "$dp_url" || true ;;
    fetch) fetch -q -T 30 -o "$CS_TMP" "$dp_url" || true ;;
    apt-helper)
      /usr/lib/apt/apt-helper -o APT::Sandbox::User=root download-file "$dp_url" "$CS_TMP" \
        >/dev/null || true
      ;;
    *) ;;
  esac
}

# Prints the SHA-256 of the file. Two files with the same hash have the same bytes, which is
# the comparison the self-check needs: cmp is missing from some supported systems (Amazon
# Linux, Rocky Linux), and a comparison in the shell would lose NUL bytes and final newlines.
# FreeBSD has sha256 and no sha256sum.
file_hash() {
  if command -v sha256sum >/dev/null 2>&1; then
    fh_line=$(sha256sum "$1")
    echo "${fh_line%% *}"
  elif command -v sha256 >/dev/null 2>&1; then
    sha256 -q "$1"
  else
    die "this script needs sha256sum to check itself. Install it and run this script again."
  fi
}

# Stops before anything is written when this script is not the published one, so a download
# that is incomplete, was changed, or is not the latest setup script changes nothing. A script
# piped into a shell has no file to compare.
check_self() {
  if [ ! -f "$0" ]; then
    cs_lines=$(latest_lines any)
    die "this script checks itself before it changes anything, and it can only do that when it is run from a file.

Download it to a file and run it:
$cs_lines"
  fi
  cs_tool=$(find_download_tool)
  if [ -z "$cs_tool" ]; then
    die "this script checks itself against $BASE_URL/setup.sh and needs curl or wget for that." \
      "Install one of them and run this script again."
  fi
  CS_TMP=$(mktemp)
  download_published "$cs_tool"
  if [ ! -s "$CS_TMP" ]; then
    # A minimal system without the certificate bundle fails here too, so the message names it.
    die "could not download $BASE_URL/setup.sh to check this script. Nothing was changed." \
      "Check the network connection, and on a minimal system that the ca-certificates package" \
      "is installed, then run this script again."
  fi
  cs_own=$(file_hash "$0")
  cs_published=$(file_hash "$CS_TMP")
  if [ "$cs_own" != "$cs_published" ]; then
    die_latest "$cs_tool" "this copy of the setup script does not match the published one. It is incomplete, was changed, or is not the latest setup script. Nothing was changed."
  fi
}

# Removes the files write_file and the self-check are working on when the script is
# interrupted. The EXIT trap keeps the exit status of the command that triggered it.
cleanup() {
  if [ -n "${WF_TMP:-}" ]; then
    rm -f "$WF_TMP"
  fi
  if [ -n "${CS_TMP:-}" ]; then
    rm -f "$CS_TMP"
  fi
}

# Both sources are always set up so either package can be installed with the system's own
# command.
run_setup() {
  check_setup_system
  check_cpu
  "setup_$FAMILY"
  echo
  next_steps
}

run_remove() {
  "remove_$FAMILY"
  echo
  remove_steps
}

main() {
  WF_TMP=
  CS_TMP=
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  case "$#:${1:-}" in
    0:) main_action=setup ;;
    1:--remove) main_action=remove ;;
    *)
      usage
      exit 2
      ;;
  esac
  main_uid=$(id -u)
  if [ "$main_uid" -ne 0 ]; then
    die "run this script as root, for example with sudo"
  fi
  check_self
  detect_family
  check_tools
  "run_$main_action"
}

main "$@"
