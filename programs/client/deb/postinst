#!/bin/sh
# Runs after the package's files are in place. $2 is not used to tell a first install from an
# upgrade: after a remove without purge dpkg still passes the old version to a fresh install.
# The service steps need no such test.
set -e

case "$1" in
    configure)
        # mount(8) looks for its helpers in /sbin. Where /sbin is a folder of its own and not a link
        # to /usr/sbin, the helper needs a link there as well. Versions before the control tool
        # linked it to the splicefs program, which is not the helper any more.
        if [ ! -L /sbin ]; then
            helper_target="$(readlink /sbin/mount.splicefs 2>/dev/null)" || helper_target=""
            if [ ! -e /sbin/mount.splicefs ] || [ "$helper_target" = /usr/bin/splicefs ]; then
                ln -sf /usr/bin/splicefsctl /sbin/mount.splicefs
            fi
        fi
        @service:after-files@
        ;;
    *)
        # abort-upgrade, abort-remove and abort-deconfigure leave nothing to set up.
        ;;
esac
