# Maintainer: SpliceFS <anthony@splicefs.org>
# abuild only wraps files here. scripts/package-apk.sh fills in the name, the version and the
# revision and says where the compiled program (STAGE), the definitions of the program (DEFS), the
# links (LINK_ROOT), the license (LICENSE_FILE) and the documents (DOCS) are.
pkgname=@NAME@
pkgver=@VERSION@
pkgrel=@REVISION@
pkgdesc="Client of the SpliceFS read-only multi-source filesystem"
url="https://github.com/SpliceFS/client"
arch="x86_64 aarch64"
license="MIT"
depends="fuse3"
# The binary is compiled and tested before this step, and it is already stripped.
options="!check !strip"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"

package() {
	install -D -m 755 "$STAGE/splicefs" "$pkgdir/usr/bin/splicefs"
	install -D -m 755 "$STAGE/splicefsctl" "$pkgdir/usr/bin/splicefsctl"
	install -D -m 755 "$DEFS/openrc/splicefs.initd" "$pkgdir/etc/init.d/splicefs"
	# The links of programs/client/links: mount runs mount.splicefs for "mount -t splicefs" and
	# for fstab lines of that type.
	cp -a "$LINK_ROOT"/. "$pkgdir/"
	# Empty on purpose: the administrator's files go here and no package file ever does.
	install -d "$pkgdir/etc/splicefs/client/conf.d" "$pkgdir/etc/splicefs/client/clusters.d" \
		"$pkgdir/etc/splicefs/client/mounts.d"
	install -D -m 644 "$LICENSE_FILE" "$pkgdir/usr/share/doc/$pkgname/LICENSE"
	# DOCS is a list of paths without spaces, split on purpose.
	# shellcheck disable=SC2086
	install -m 644 $DOCS "$pkgdir/usr/share/doc/$pkgname/"
}
