#!/bin/sh
# rc.d service of the SpliceFS server on FreeBSD.
#
# PROVIDE: splicefsd
# REQUIRE: NETWORKING DAEMON
# KEYWORD: shutdown
#
# Settings for /etc/rc.conf:
#   splicefsd_enable   "YES" starts the server at boot and lets "service splicefsd start" run
#                      it. The default is "NO": installing the package starts nothing and
#                      turns nothing on, and pkg would end a process its scripts started.

# rc.subr reads rcvar, command, command_args, extra_commands, start_precmd, stop_postcmd and reload_cmd.
# shellcheck disable=SC2034
# shellcheck source=/dev/null
. /etc/rc.subr

name=splicefsd
rcvar=splicefsd_enable
load_rc_config "$name"

: "${splicefsd_enable:=NO}"

program=/usr/local/bin/splicefsd
statedir=/var/db/splicefs/server
logfile=/var/log/splicefsd.log
# The pid files belong to root: daemon(8) writes them before it drops privileges. daemon(8) writes
# two: its own, which stop and status use, and the server's, which reload needs because the
# signal must reach the server and not its supervisor.
rundir=/var/run/splicefsd
pidfile="${rundir}/daemon.pid"
childpidfile="${rundir}/splicefsd.pid"

# daemon(8) drops to the service user itself (-u), so rc.subr must not wrap it in su.
command=/usr/sbin/daemon
# -r restarts the server when it exits, which is what Restart=on-failure does in the
# systemd unit; -R 5 waits five seconds first.
command_args="-f -r -R 5 -P ${pidfile} -p ${childpidfile} -u splicefs -o ${logfile} ${program}"

extra_commands=reload
start_precmd=splicefsd_prestart
stop_postcmd=splicefsd_cleanup
reload_cmd=splicefsd_reload

splicefsd_prestart() {
    # The server keeps its data here and creates local/ and shared/ inside on first start.
    install -d -o root -g wheel -m 0755 /var/db/splicefs
    install -d -o splicefs -g splicefs -m 0750 "${statedir}"
    install -d -o root -g wheel -m 0755 "${rundir}"
}

# rc.subr runs this once the service has stopped. The start made the folder, so the stop takes it
# away and a stopped service leaves nothing in /var/run.
splicefsd_cleanup() {
    rm -rf "${rundir}"
}

splicefsd_reload() {
    # The server applies its configuration again on SIGHUP: requests in progress finish and
    # a configuration with an error is refused and only logged.
    if [ ! -r "${childpidfile}" ]; then
        echo "${name} is not running."
        return 1
    fi
    server_pid="$(cat "${childpidfile}")"
    kill -HUP "${server_pid}"
}

run_rc_command "$1"
