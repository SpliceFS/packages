# Maintainer: SpliceFS <anthony@splicefs.org>
# abuild only wraps files here. scripts/package-apk.sh fills in the name and the version and says
# where the compiled program (STAGE), the definitions of the program (DEFS), the license
# (LICENSE_FILE) and the documents (DOCS) are.
pkgname=@NAME@
pkgver=@VERSION@
pkgrel=0
pkgdesc="Server of the SpliceFS read-only multi-source filesystem"
url="https://github.com/SpliceFS/server"
arch="x86_64 aarch64"
license="MIT"
# The binary is compiled and tested before this step, and it is already stripped.
options="!check !strip"
install="$pkgname.pre-install $pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"

package() {
	install -D -m 755 "$STAGE/splicefsd" "$pkgdir/usr/bin/splicefsd"
	install -D -m 755 "$DEFS/openrc/splicefsd.initd" "$pkgdir/etc/init.d/splicefsd"
	# Empty on purpose: the administrator's files go here and no package file ever does.
	install -d "$pkgdir/etc/splicefs/server/conf.d" "$pkgdir/etc/splicefs/server/shares.d"
	install -D -m 644 "$LICENSE_FILE" "$pkgdir/usr/share/doc/$pkgname/LICENSE"
	# DOCS is a list of paths without spaces, split on purpose.
	# shellcheck disable=SC2086
	install -m 644 $DOCS "$pkgdir/usr/share/doc/$pkgname/"
}
