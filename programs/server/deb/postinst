#!/bin/sh
# Runs after the package's files are in place. $2 is not used to tell a first install from an
# upgrade: after a remove without purge dpkg still passes the old version to a fresh install.
# The service steps need no such test.
set -e

case "$1" in
    configure)
        # The server runs as its own user so that a bug in it has no more rights than
        # reading what that user was given.
        if ! getent passwd splicefs >/dev/null; then
            useradd --system --user-group --no-create-home --home-dir /nonexistent \
                --shell /usr/sbin/nologin splicefs
        fi
        @service:after-files@
        ;;
    *)
        # abort-upgrade, abort-remove and abort-deconfigure leave nothing to set up.
        ;;
esac
