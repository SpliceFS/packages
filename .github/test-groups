# The test groups that each changed path of a pull request needs (scripts/changed-groups.sh).
# A line is a shell pattern, in which * also matches /, and the groups it needs; a pattern alone
# needs none. The checks job runs for every change, so a change that needs no group runs the
# checks alone. The first line that matches a path decides, so a narrow pattern comes before a
# wide one. A path that no line matches needs every group.
#
# deb       the deb packages of both programs, and their tests on every system and CPU type
# rpm       the rpm packages, the same
# apk       the Alpine packages, the same
# freebsd   the FreeBSD packages, built and checked in a machine of each release
#           (deb, rpm and apk are tested with the package test of both programs and the version order too: ci.yml)
# install   the setup script run on every system and on FreeBSD, against the published site
#           (install-tests.yml). It needs only the setup script, its own tests and its own
#           workflow: it builds no package, so no change to a package can affect it.

# The setup script and its own tests. The FreeBSD package test also writes its repository file
# with the setup script's pkg_conf.
setup.sh.in                         install freebsd
tests/*                             install
.github/workflows/install-tests.yml install
# No test reads the pull request template or the settings of the dependency bot.
.github/PULL_REQUEST_TEMPLATE.md
.github/dependabot.yml

# One package format.
programs/*/deb/*                    deb
scripts/*-deb.sh                    deb
scripts/repo-apt.sh                 deb
scripts/service-test-host*          deb
steps/uninstall-apt.sh              deb
programs/*/rpm/*                    rpm
scripts/*-rpm.sh                    rpm
steps/uninstall-dnf.sh              rpm
steps/uninstall-zypper.sh           rpm
programs/*/alpine/*                 apk
programs/*/openrc/*                 apk
packaging/service/openrc/*          apk
scripts/*-apk.sh                    apk
scripts/apk-resign*                 apk
steps/uninstall-apk.sh              apk
programs/*/freebsd/*                freebsd
packaging/freebsd/*                 freebsd
scripts/freebsd-*                   freebsd
scripts/*-freebsd.sh                freebsd
steps/uninstall-pkg.sh              freebsd

# Shared by two formats.
programs/*/systemd/*                deb rpm
packaging/service/systemd/*         deb rpm
packaging/test-systems              deb rpm apk

# What every format uses: the programs, the scripts, the Makefile, the manual steps that the
# package and user mode tests run, the workflows, the actions, and the published keys that prove
# the release archives before they are packaged.
programs/*                          deb rpm apk freebsd
packaging/*                         deb rpm apk freebsd
scripts/*                           deb rpm apk freebsd
Makefile                            deb rpm apk freebsd
steps/*                             deb rpm apk freebsd
keys/*                              deb rpm apk freebsd
.github/*                           deb rpm apk freebsd

# Read by make check alone, or by no test.
site/*
*.md
LICENSE
.gitignore
.shellcheckrc
sonar-project.properties
